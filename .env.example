# Authentication: create Google and Microsoft OAuth/OIDC applications and register
# their callback URLs as https://<your-vercel-domain>/api/auth/callback/google
# and https://<your-vercel-domain>/api/auth/callback/azure-ad.
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Email link sign-in uses Resend and the D1 auth migration. Use a verified sender.
RESEND_API_KEY=
EMAIL_FROM=
# Protects the daily retention cleanup endpoint.
CRON_SECRET=

# Existing private Cloudflare storage, accessed only from server functions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Production release gate. Keep MYFTC_DATA_ENABLED false/empty until approved.
MYFTC_DATA_ENABLED=false
MYFTC_SERVICE_PAUSED=false
MYFTC_READINESS_RECORD=
